# Shell scripts must keep LF endings. Git on Windows checks them out as CRLF by
# default, and a script with CRLF fails inside a Linux container with
# "/usr/bin/env: 'bash\r': No such file or directory" — which reads like a
# missing interpreter rather than a line-ending problem.
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
