# Arogya backend environment configuration
# Copy this file, fill in your keys, and the app will pick them up automatically.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./arogya.db

# ── OCR (prescription scanning) ──────────────────────────────────────────────
# OCR_PROVIDER:
#   auto      (default) Tesseract first, then Gemini vision when Tesseract is
#             missing, errors, or reads no known medicine. Best of both:
#             clean printed scans stay local and free, hard/handwritten ones
#             get the vision model.
#   tesseract local only, never calls Gemini
#   gemini    always use Gemini vision (skips Tesseract entirely)
OCR_PROVIDER=auto
# Vision model used when Tesseract can't read the image (handwriting, blur,
# rotation). Verified working with the current key.
GEMINI_VISION_MODEL=gemini-2.5-flash

# Tesseract OCR binary (a system package, not a pip install -- see README
# "Installing Tesseract"). Installed here into a user-owned conda env, which
# needs no admin rights:
#   conda create -p "%USERPROFILE%\.conda\envs\tesseract" -c conda-forge tesseract -y --solver=libmamba
# With OCR_PROVIDER=auto the app still works if this is wrong/missing -- it
# just falls through to Gemini vision for every upload.
TESSERACT_CMD=C:path	o	esseract.exe

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-before-deploying
OTP_DEV_MODE=true

# ── Chatbot / LLM ─────────────────────────────────────────────────────────────
# Set to "google" to use Gemini, or leave as "retrieval" for the keyword fallback
# NOTE: Gemini's FREE tier allows only ~20 requests per day PER MODEL. When
# that's used up the API returns 429 and the chatbot silently drops back to
# short template answers. Each model has its own quota bucket, so the app
# automatically tries GEMINI_FALLBACK_MODELS before giving up. For real usage,
# enable billing on your Google AI Studio project to lift the cap.
LLM_PROVIDER=google
GOOGLE_API_KEY=your-google-ai-studio-key-here
GEMINI_MODEL=gemini-3-flash-preview
# Only models this project is actually permitted to call on the free tier.
# Excluded deliberately, each verified against this key:
#   *-lite, gemini-3.6-flash, gemini-3.7-flash -> 403 PERMISSION_DENIED
#   gemini-3.1-pro-preview                     -> free-tier quota "limit: 0"
#                                                 (paid-only; can never succeed)
# Listing any of those just burns a wasted round-trip per message.
# Must be DIFFERENT models from the primary. Gemini's free tier meters
# requests per model per day, so listing the same model as its own fallback
# just retries an already-exhausted bucket. Each distinct model here adds
# another ~20 requests/day of headroom.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
CHAT_HISTORY_TURNS=6

# ── Other integrations (optional) ────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# BHASHINI_API_KEY=
# GOOGLE_PLACES_API_KEY=your-google-cloud-key-here

# ── Notifications (SMS reminders via MSG91) ──────────────────────────────────
# Set NOTIFICATION_PROVIDER=msg91 and fill these in to send real reminder
# texts. Until then it stays "mock" (logs only, visible in server logs).
# MSG91 requires a DLT-approved "Flow" (template) -- create one in your MSG91
# dashboard with a single variable, e.g. template body "Arogya: ##VAR1##",
# then copy its Flow ID below.
NOTIFICATION_PROVIDER=mock
# MSG91_AUTH_KEY=
# MSG91_FLOW_ID=
# MSG91_SENDER_ID=